{
  "name": "@oryon/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript client for OryonOS public REST API",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --strict --target ES2024 --module NodeNext --moduleResolution NodeNext --declaration --outDir dist src/index.ts",
    "typecheck": "tsc --strict --target ES2024 --module NodeNext --moduleResolution NodeNext --noEmit src/index.ts"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "dependencies": {
    "@oryon/contracts": "workspace:*",
    "zod": "^4.0.0"
  }
}
