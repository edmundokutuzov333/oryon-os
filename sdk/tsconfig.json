{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": false,
    "declaration": true,
    "outDir": "./dist",
    "baseUrl": "..",
    "paths": {
      "@oryon/contracts/*": ["packages/contracts/src/*"]
    },
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"]
}
