// ============================================================================
// ORYON OS — SCHEMA CANÓNICO V1
// PostgreSQL 17 · Prisma 6
// ----------------------------------------------------------------------------
// REGRAS DE OURO
//  1. Toda a tabela de negócio tem `orgId` e índice composto com `orgId` primeiro.
//  2. Toda a tabela de negócio tem RLS activo.
//  3. Todo tipo de trabalho vive em `WorkObject`. Campos específicos vivem em
//     `customFields`; consultas quentes usam os campos universais promovíveis.
//  4. Relações entre objectos são `Edge`. Nunca FK ad-hoc entre tipos de trabalho.
//  5. Nenhuma mutação sem `DomainEvent` emitido na mesma transacção (outbox).
//  6. Dinheiro é `Decimal(19,4)` + `currency`. Nunca Float.
//  7. Soft delete via `deletedAt`. Hard delete só por retenção ou pedido RGPD.
// ============================================================================

generator client {
  provider        = "prisma-client"
  output          = "../src/generated"
  previewFeatures = ["driverAdapters", "typedSql", "postgresqlExtensions", "relationJoins"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DATABASE_DIRECT_URL")
  extensions = [pgcrypto, pg_trgm, vector, uuidOssp(map: "uuid-ossp")]
}

model Organization {
  id                String     @id @default(cuid(2))
  slug              String     @unique
  name              String
  logoUrl           String?
  primaryDomain     String?
  dataRegion        DataRegion @default(EU)
  reportingCurrency String     @default("USD") @map("reporting_currency")
  defaultLocale     String     @default("pt-MZ") @map("default_locale")
  defaultTimezone   String     @default("Africa/Maputo") @map("default_timezone")
  plan              PlanTier   @default(TRIAL)
  settings          Json       @default("{}")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  deletedAt         DateTime?  @map("deleted_at")

  workspaces          Workspace[]
  users               User[]
  teams               Team[]
  workObjects         WorkObject[]
  channels            Channel[]
  agents              Agent[]
  roles               Role[]
  grants              AccessGrant[]
  labels              ClassificationLabel[]
  objectTypes         ObjectTypeDef[]
  comments            Comment[]
  files               FileAsset[]
  approvals           Approval[]
  pages               Page[]
  databases           DataBase[]
  workflows           Workflow[]
  events              DomainEvent[]
  runs                AgentRun[]
  modelPolicies       ModelPolicy[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  meetings            Meeting[]
  edges               Edge[]
  channelMembers      ChannelMember[]
  emailAccounts       EmailAccount[]
  emailThreads        EmailThread[]
  meetingParticipants MeetingParticipant[]
  meetingArtifacts    MeetingArtifact[]
  rooms               Room[]
  pageVersions        PageVersion[]
  dataRecords         DataRecord[]
  savedViews          SavedView[]
  workflowRuns        WorkflowRun[]
  attachments         Attachment[]
  timeEntries         TimeEntry[]
  messages            Message[]
  reactions           Reaction[]

  @@map("organizations")
}

model Workspace {
  id         String     @id @default(cuid(2))
  orgId      String     @map("org_id")
  key        String
  name       String
  icon       String?
  visibility Visibility @default(ORG)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  deletedAt  DateTime?  @map("deleted_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, key])
  @@index([orgId])
  @@map("workspaces")
}

model User {
  id              String        @id @default(cuid(2))
  orgId           String        @map("org_id")
  email           String
  emailVerified   DateTime?     @map("email_verified")
  name            String
  displayName     String?       @map("display_name")
  avatarUrl       String?       @map("avatar_url")
  jobTitle        String?       @map("job_title")
  timezone        String        @default("Africa/Maputo")
  locale          String        @default("pt-MZ")
  workingHours    Json?         @map("working_hours")
  type            PrincipalType @default(MEMBER)
  status          UserStatus    @default(ACTIVE)
  managerId       String?       @map("manager_id")
  lastSeenAt      DateTime?     @map("last_seen_at")
  presence        PresenceState @default(OFFLINE)
  statusEmoji     String?       @map("status_emoji")
  statusText      String?       @map("status_text")
  statusExpiresAt DateTime?     @map("status_expires_at")
  externalId      String?       @map("external_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")

  org                 Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  manager             User?                @relation("ReportsTo", fields: [managerId], references: [id])
  reports             User[]               @relation("ReportsTo")
  teamMembers         TeamMember[]
  roleBindings        RoleBinding[]
  ownedObjects        WorkObject[]         @relation("ObjectOwner")
  assignments         Assignment[]
  messages            Message[]
  comments            Comment[]
  agents              Agent[]              @relation("AgentPrincipal")
  auditLogs           AuditLog[]
  timeEntries         TimeEntry[]
  channelMembers      ChannelMember[]
  reactions           Reaction[]
  meetingParticipants MeetingParticipant[]
  notifications       Notification[]

  @@unique([orgId, email])
  @@index([orgId, status])
  @@index([orgId, managerId])
  @@map("users")
}

model Team {
  id           String    @id @default(cuid(2))
  orgId        String    @map("org_id")
  name         String
  slug         String
  description  String?
  parentTeamId String?   @map("parent_team_id")
  leadUserId   String?   @map("lead_user_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parentTeam Team?        @relation("TeamTree", fields: [parentTeamId], references: [id])
  children   Team[]       @relation("TeamTree")
  members    TeamMember[]

  @@unique([orgId, slug])
  @@index([orgId, parentTeamId])
  @@map("teams")
}

model TeamMember {
  id       String   @id @default(cuid(2))
  orgId    String   @map("org_id")
  teamId   String   @map("team_id")
  userId   String   @map("user_id")
  role     TeamRole @default(MEMBER)
  joinedAt DateTime @default(now()) @map("joined_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([orgId, userId])
  @@map("team_members")
}

model Agent {
  id               String           @id @default(cuid(2))
  orgId            String           @map("org_id")
  key              String
  name             String
  description      String?
  avatarUrl        String?          @map("avatar_url")
  principalId      String           @map("principal_id")
  systemPrompt     String           @map("system_prompt") @db.Text
  modelPolicyId    String?          @map("model_policy_id")
  knowledgeScope   Json             @default("{}") @map("knowledge_scope")
  tools            Json             @default("[]")
  triggers         Json             @default("[]")
  schedule         String?
  checkpointPolicy CheckpointPolicy @default(SENSITIVE_ONLY) @map("checkpoint_policy")
  budgetCapCents   BigInt?          @map("budget_cap_cents")
  status           AgentStatus      @default(DRAFT)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  deletedAt        DateTime?        @map("deleted_at")

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  principal   User         @relation("AgentPrincipal", fields: [principalId], references: [id])
  modelPolicy ModelPolicy? @relation(fields: [modelPolicyId], references: [id])
  runs        AgentRun[]

  @@unique([orgId, key])
  @@index([orgId, status])
  @@map("agents")
}

model Role {
  id          String   @id @default(cuid(2))
  orgId       String   @map("org_id")
  key         String
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  permissions String[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  org      Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  bindings RoleBinding[]

  @@unique([orgId, key])
  @@map("roles")
}

model RoleBinding {
  id          String    @id @default(cuid(2))
  orgId       String    @map("org_id")
  roleId      String    @map("role_id")
  principalId String    @map("principal_id")
  scopeType   ScopeType @map("scope_type")
  scopeId     String?   @map("scope_id")
  grantedBy   String    @map("granted_by")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  role      Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  principal User @relation(fields: [principalId], references: [id], onDelete: Cascade)

  @@unique([roleId, principalId, scopeType, scopeId])
  @@index([orgId, principalId])
  @@index([orgId, expiresAt])
  @@map("role_bindings")
}

model AccessGrant {
  id            String      @id @default(cuid(2))
  orgId         String      @map("org_id")
  resourceType  String      @map("resource_type")
  resourceId    String      @map("resource_id")
  principalId   String?     @map("principal_id")
  teamId        String?     @map("team_id")
  externalEmail String?     @map("external_email")
  level         AccessLevel
  fieldMask     String[]    @map("field_mask")
  grantedBy     String      @map("granted_by")
  reason        String?
  expiresAt     DateTime?   @map("expires_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  revokedAt     DateTime?   @map("revoked_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, resourceType, resourceId])
  @@index([orgId, principalId])
  @@index([orgId, expiresAt])
  @@map("access_grants")
}

model ClassificationLabel {
  id             String  @id @default(cuid(2))
  orgId          String  @map("org_id")
  key            String
  name           String
  rank           Int
  blocksExternal Boolean @default(false) @map("blocks_external")
  blocksAi       Boolean @default(false) @map("blocks_ai")
  blocksDownload Boolean @default(false) @map("blocks_download")
  watermark      Boolean @default(false)
  retentionDays  Int?    @map("retention_days")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, key])
  @@map("classification_labels")
}

model ObjectTypeDef {
  id           String   @id @default(cuid(2))
  orgId        String   @map("org_id")
  key          String
  name         String
  pluralName   String   @map("plural_name")
  icon         String?
  color        String?
  isSystem     Boolean  @default(false) @map("is_system")
  idPrefix     String   @map("id_prefix")
  schema       Json     @default("{}")
  statusModel  Json     @default("{}") @map("status_model")
  defaultViews Json     @default("[]") @map("default_views")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  objects WorkObject[]

  @@unique([orgId, key])
  @@map("object_type_defs")
}

model WorkObject {
  id              String                       @id @default(cuid(2))
  orgId           String                       @map("org_id")
  workspaceId     String?                      @map("workspace_id")
  typeKey         String                       @map("type_key")
  typeDefId       String                       @map("type_def_id")
  humanId         String                       @map("human_id")
  title           String
  description     String?                      @db.Text
  status          String                       @default("open")
  statusCategory  StatusCategory               @default(TODO) @map("status_category")
  priority        Priority                     @default(NORMAL)
  ownerId         String?                      @map("owner_id")
  parentObjectId  String?                      @map("parent_object_id")
  startAt         DateTime?                    @map("start_at")
  dueAt           DateTime?                    @map("due_at")
  completedAt     DateTime?                    @map("completed_at")
  estimateMinutes Int?                         @map("estimate_minutes")
  actualMinutes   Int?                         @map("actual_minutes")
  progress        Int                          @default(0)
  moneyAmount     Decimal?                     @map("money_amount") @db.Decimal(19, 4)
  moneyCurrency   String?                      @map("money_currency")
  probability     Int?
  secondaryDate   DateTime?                    @map("secondary_date")
  externalRef     String?                      @map("external_ref")
  severity        Int?
  classification  String?
  tags            String[]
  customFields    Json                         @default("{}") @map("custom_fields")
  searchVector    Unsupported("tsvector")?     @map("search_vector")
  embedding       Unsupported("vector(1536)")?
  createdBy       String                       @map("created_by")
  createdAt       DateTime                     @default(now()) @map("created_at")
  updatedAt       DateTime                     @updatedAt @map("updated_at")
  deletedAt       DateTime?                    @map("deleted_at")

  org           Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  typeDef       ObjectTypeDef      @relation(fields: [typeDefId], references: [id])
  owner         User?              @relation("ObjectOwner", fields: [ownerId], references: [id])
  parent        WorkObject?        @relation("ObjectTree", fields: [parentObjectId], references: [id])
  children      WorkObject[]       @relation("ObjectTree")
  assignments   Assignment[]
  comments      Comment[]
  attachments   Attachment[]
  placements    ObjectPlacement[]
  approvals     Approval[]
  timeEntries   TimeEntry[]
  statusHistory StatusTransition[]

  @@unique([orgId, humanId])
  @@index([orgId, typeKey, statusCategory])
  @@index([orgId, ownerId, dueAt])
  @@index([orgId, workspaceId, updatedAt])
  @@index([orgId, parentObjectId])
  @@index([orgId, externalRef])
  @@map("work_objects")
}

model ObjectPlacement {
  id            String        @id @default(cuid(2))
  orgId         String        @map("org_id")
  objectId      String        @map("object_id")
  containerType ContainerType @map("container_type")
  containerId   String        @map("container_id")
  sectionId     String?       @map("section_id")
  position      Decimal       @db.Decimal(20, 10)
  isPrimary     Boolean       @default(false) @map("is_primary")
  createdAt     DateTime      @default(now()) @map("created_at")

  object WorkObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@unique([objectId, containerType, containerId])
  @@index([orgId, containerType, containerId, position])
  @@map("object_placements")
}

model Assignment {
  id         String         @id @default(cuid(2))
  orgId      String         @map("org_id")
  objectId   String         @map("object_id")
  userId     String?        @map("user_id")
  agentId    String?        @map("agent_id")
  role       AssignmentRole @default(ASSIGNEE)
  allocation Int?
  assignedAt DateTime       @default(now()) @map("assigned_at")

  object WorkObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  user   User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([objectId, userId, role])
  @@index([orgId, userId])
  @@map("assignments")
}

model Edge {
  id        String       @id @default(cuid(2))
  orgId     String       @map("org_id")
  fromType  String       @map("from_type")
  fromId    String       @map("from_id")
  toType    String       @map("to_type")
  toId      String       @map("to_id")
  relation  EdgeRelation
  lagDays   Int?         @map("lag_days")
  metadata  Json         @default("{}")
  createdBy String       @map("created_by")
  createdAt DateTime     @default(now()) @map("created_at")
  deletedAt DateTime?    @map("deleted_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([fromType, fromId, toType, toId, relation])
  @@index([orgId, fromType, fromId, relation])
  @@index([orgId, toType, toId, relation])
  @@map("edges")
}

model StatusTransition {
  id         String        @id @default(cuid(2))
  orgId      String        @map("org_id")
  objectId   String        @map("object_id")
  fromStatus String?       @map("from_status")
  toStatus   String        @map("to_status")
  actorId    String        @map("actor_id")
  actorType  PrincipalType @map("actor_type")
  comment    String?
  durationMs BigInt?       @map("duration_ms")
  createdAt  DateTime      @default(now()) @map("created_at")

  object WorkObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@index([orgId, objectId, createdAt])
  @@map("status_transitions")
}

model Comment {
  id         String        @id @default(cuid(2))
  orgId      String        @map("org_id")
  objectId   String?       @map("object_id")
  targetType String        @map("target_type")
  targetId   String        @map("target_id")
  parentId   String?       @map("parent_id")
  authorId   String        @map("author_id")
  authorType PrincipalType @default(MEMBER) @map("author_type")
  bodyJson   Json          @map("body_json")
  bodyText   String        @map("body_text") @db.Text
  mentions   String[]
  isInternal Boolean       @default(false) @map("is_internal")
  resolvedAt DateTime?     @map("resolved_at")
  resolvedBy String?       @map("resolved_by")
  anchorJson Json?         @map("anchor_json")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  deletedAt  DateTime?     @map("deleted_at")

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  object  WorkObject?  @relation(fields: [objectId], references: [id], onDelete: Cascade)
  author  User         @relation(fields: [authorId], references: [id])
  parent  Comment?     @relation("CommentTree", fields: [parentId], references: [id])
  replies Comment[]    @relation("CommentTree")

  @@index([orgId, targetType, targetId, createdAt])
  @@map("comments")
}

model FileAsset {
  id                String                       @id @default(cuid(2))
  orgId             String                       @map("org_id")
  name              String
  mimeType          String                       @map("mime_type")
  sizeBytes         BigInt                       @map("size_bytes")
  storageKey        String                       @map("storage_key")
  checksumSha256    String                       @map("checksum_sha256")
  version           Int                          @default(1)
  previousVersionId String?                      @map("previous_version_id")
  folderId          String?                      @map("folder_id")
  tags              String[]
  classification    String?
  ocrText           String?                      @map("ocr_text") @db.Text
  embedding         Unsupported("vector(1536)")?
  licenseExpiresAt  DateTime?                    @map("license_expires_at")
  uploadedBy        String                       @map("uploaded_by")
  createdAt         DateTime                     @default(now()) @map("created_at")
  deletedAt         DateTime?                    @map("deleted_at")

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@unique([orgId, checksumSha256, version])
  @@index([orgId, folderId])
  @@map("file_assets")
}

model Attachment {
  id         String   @id @default(cuid(2))
  orgId      String   @map("org_id")
  fileId     String   @map("file_id")
  objectId   String?  @map("object_id")
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  createdAt  DateTime @default(now()) @map("created_at")

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  file   FileAsset    @relation(fields: [fileId], references: [id], onDelete: Cascade)
  object WorkObject?  @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@unique([fileId, targetType, targetId])
  @@index([orgId, targetType, targetId])
  @@map("attachments")
}

model Approval {
  id             String        @id @default(cuid(2))
  orgId          String        @map("org_id")
  objectId       String        @map("object_id")
  stepIndex      Int           @map("step_index")
  mode           ApprovalMode  @default(SEQUENTIAL)
  quorum         Int?
  approverId     String?       @map("approver_id")
  approverTeamId String?       @map("approver_team_id")
  delegatedToId  String?       @map("delegated_to_id")
  state          ApprovalState @default(PENDING)
  comment        String?
  signatureId    String?       @map("signature_id")
  dueAt          DateTime?     @map("due_at")
  escalatedAt    DateTime?     @map("escalated_at")
  decidedAt      DateTime?     @map("decided_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  object WorkObject   @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@index([orgId, approverId, state])
  @@index([orgId, objectId, stepIndex])
  @@map("approvals")
}

model TimeEntry {
  id           String    @id @default(cuid(2))
  orgId        String    @map("org_id")
  objectId     String    @map("object_id")
  userId       String    @map("user_id")
  startedAt    DateTime  @map("started_at")
  endedAt      DateTime? @map("ended_at")
  minutes      Int
  billable     Boolean   @default(false)
  rateAmount   Decimal?  @map("rate_amount") @db.Decimal(19, 4)
  rateCurrency String?   @map("rate_currency")
  note         String?
  approvedBy   String?   @map("approved_by")
  approvedAt   DateTime? @map("approved_at")
  lockedAt     DateTime? @map("locked_at")

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  object WorkObject   @relation(fields: [objectId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id])

  @@index([orgId, userId, startedAt])
  @@index([orgId, objectId])
  @@map("time_entries")
}

model Channel {
  id               String      @id @default(cuid(2))
  orgId            String      @map("org_id")
  workspaceId      String?     @map("workspace_id")
  key              String
  name             String
  topic            String?
  purpose          String?
  kind             ChannelKind @default(TEXT)
  visibility       Visibility  @default(ORG)
  isShared         Boolean     @default(false) @map("is_shared")
  sharedWithOrgIds String[]    @map("shared_with_org_ids")
  linkedObjectId   String?     @map("linked_object_id")
  slaMinutes       Int?        @map("sla_minutes")
  retentionDays    Int?        @map("retention_days")
  aiExcluded       Boolean     @default(false) @map("ai_excluded")
  archivedAt       DateTime?   @map("archived_at")
  createdBy        String      @map("created_by")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  org      Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members  ChannelMember[]
  messages Message[]

  @@unique([orgId, key])
  @@index([orgId, kind, archivedAt])
  @@map("channels")
}

model ChannelMember {
  id           String            @id @default(cuid(2))
  orgId        String            @map("org_id")
  channelId    String            @map("channel_id")
  userId       String            @map("user_id")
  role         ChannelRole       @default(MEMBER)
  lastReadAt   DateTime?         @map("last_read_at")
  notification NotificationLevel @default(MENTIONS)
  mutedUntil   DateTime?         @map("muted_until")
  joinedAt     DateTime          @default(now()) @map("joined_at")

  channel        Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?

  @@unique([channelId, userId])
  @@index([orgId, userId])
  @@map("channel_members")
}

model Message {
  id           String        @id @default(cuid(2))
  orgId        String        @map("org_id")
  channelId    String        @map("channel_id")
  parentId     String?       @map("parent_id")
  authorId     String        @map("author_id")
  authorType   PrincipalType @default(MEMBER) @map("author_type")
  bodyJson     Json          @map("body_json")
  bodyText     String        @map("body_text") @db.Text
  mentions     String[]
  kind         MessageKind   @default(TEXT)
  mediaFileId  String?       @map("media_file_id")
  transcript   String?       @db.Text
  sourceLocale String?       @map("source_locale")
  translations Json          @default("{}")
  replyCount   Int           @default(0) @map("reply_count")
