{
  "name": "oryon-os",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "turbo run dev --parallel --filter=./apps/* --filter=./packages/*",
    "build": "turbo run build --filter=./apps/* --filter=./packages/*",
    "typecheck": "turbo run typecheck --filter=./apps/* --filter=./packages/*",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "turbo run test --filter=./apps/* --filter=./packages/* -- --passWithNoTests",
    "test:coverage": "turbo run test --filter=./apps/* --filter=./packages/* -- --coverage",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:visual": "node scripts/test-visual.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:v1": "node scripts/check-v1-invariants.mjs",
    "check:phase13": "node scripts/check-phase13.mjs",
    "check:phase14": "node scripts/check-phase14.mjs",
    "check:phase15": "node scripts/check-phase15.mjs",
    "gen:openapi": "pnpm --filter @oryon/api gen:openapi",
    "gen:sdk": "pnpm --dir sdk build",
    "generate": "pnpm db:generate && pnpm gen:openapi && pnpm gen:sdk",
    "validate": "pnpm db:validate && pnpm check:boundaries && pnpm check:v1 && pnpm check:phase13 && pnpm check:phase14 && pnpm check:phase15",
    "analyze:bundle": "node scripts/analyze-bundle.mjs",
    "audit:security": "node scripts/audit-security.mjs",
    "performance:gate": "node scripts/performance-gate.mjs",
    "verify": "pnpm generate && pnpm validate && pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "verify:release": "pnpm verify && pnpm test:e2e && pnpm test:visual && pnpm analyze:bundle && pnpm performance:gate && pnpm audit:security",
    "db:generate": "pnpm --filter @oryon/db db:generate",
    "db:validate": "node scripts/db-validate.mjs",
    "db:migrate:dev": "pnpm --filter @oryon/db db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @oryon/db db:migrate:deploy",
    "db:migrate:status": "pnpm --filter @oryon/db db:migrate:status",
    "db:seed": "pnpm --filter @oryon/db db:seed",
    "db:rls:verify": "pnpm --filter @oryon/db db:rls:verify",
    "infra:config": "docker compose -f infra/docker/docker-compose.yml config --quiet",
    "infra:up": "docker compose -f infra/docker/docker-compose.yml up -d --build --wait --remove-orphans postgres redis nats typesense minio livekit temporal && docker compose -f infra/docker/docker-compose.yml run --rm minio-init",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml down --remove-orphans",
    "infra:logs": "docker compose -f infra/docker/docker-compose.yml logs -f",
    "infra:status": "docker compose -f infra/docker/docker-compose.yml ps",
    "infra:doctor": "node scripts/infra-doctor.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "lefthook": "^1.11.0",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}
