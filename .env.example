# OryonOS V1 local infrastructure
# Copy to .env for local development. Never commit .env.

POSTGRES_USER=oryon
POSTGRES_PASSWORD=oryon_local
POSTGRES_DB=oryon
POSTGRES_PORT=5432
DATABASE_URL=postgresql://oryon:oryon_local@localhost:5432/oryon?schema=public
DATABASE_DIRECT_URL=postgresql://oryon:oryon_local@localhost:5432/oryon?schema=public

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

ORYON_API_URL=http://localhost:4000
ORYON_WEB_URL=http://localhost:3000
NEXT_PUBLIC_ORYON_API_URL=http://localhost:4000
ORYON_AUTH_JWT_SECRET=replace-with-at-least-32-random-bytes
ORYON_AUTH_SESSION_TTL_SECONDS=2592000
ORYON_AUTH_ACCESS_TTL_SECONDS=900
ORYON_AUTH_MAGIC_LINK_TTL_SECONDS=600
ORYON_AUTH_DEV_MODE=false
ORYON_AUTH_COOKIE_NAME=oryon_session
ORYON_AUTH_FROM=OryonOS <auth@oryon.os>
RESEND_API_KEY=

NATS_CLIENT_PORT=4222
NATS_MONITOR_PORT=8222
NATS_URL=nats://localhost:4222

TYPESENSE_PORT=8108
TYPESENSE_API_KEY=oryon-typesense-local
TYPESENSE_URL=http://localhost:8108

MINIO_ROOT_USER=oryon
MINIO_ROOT_PASSWORD=oryon_local_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=oryon-local
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=oryon
S3_SECRET_ACCESS_KEY=oryon_local_password
S3_FORCE_PATH_STYLE=true

LIVEKIT_SIGNAL_PORT=7880
LIVEKIT_TCP_PORT=7881
LIVEKIT_RTC_PORT=7882
LIVEKIT_RTC_PORT_RANGE_START=50000
LIVEKIT_RTC_PORT_RANGE_END=50100
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret